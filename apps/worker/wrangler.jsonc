{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorashidaw-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "SUPABASE_URL": "https://xdosscxenccrsshjjrpg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable__K1KlOjR7faj8se6hhcjQw_gOLXv_jM",
    "MINI_APP_URL": "https://sorashidaw-api.sorashithegod.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BEAT_ROOM",
        "class_name": "BeatRoom"
      }
    ]
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "SUPABASE_WORKER_SIGNING_SECRET"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BeatRoom"
      ]
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "DRUM_KITS",
      "bucket_name": "sorashidaw-drum-kits"
    }
  ]
}
